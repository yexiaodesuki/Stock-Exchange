{
  "description": "应用视角只读探测。fresh=0 表示未知或过期；Kafka lag 是已分配客户端分区 lag，不是完整消费组积压或资产进度。",
  "uid": "exchange-dependencies",
  "title": "Stock Exchange - 依赖与消息链路",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "依赖可用（1）/不可用（0）",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "exchange_dependency_up",
          "legendFormat": "{{application}} / {{dependency}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "依赖结果有效（1）/未知或过期（0）",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "exchange_dependency_fresh",
          "legendFormat": "{{application}} / {{dependency}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "依赖探测平均耗时（秒）",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(exchange_dependency_duration_seconds_sum[2m]) / rate(exchange_dependency_duration_seconds_count[2m])",
          "legendFormat": "{{application}} / {{dependency}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "依赖探测失败（最近5分钟）",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(exchange_dependency_checks_total{result=\"failure\"}[5m])",
          "legendFormat": "{{application}} / {{dependency}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "MySQL 应用连接池活跃连接",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{application}} / {{pool}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "MySQL 应用连接池等待线程",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "{{application}} / {{pool}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Redis 业务连接池使用",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "exchange_redis_pool_active",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "业务处理与 Kafka 结果速率",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(exchange_pipeline_operations_total[2m])",
          "legendFormat": "{{application}} / {{stage}} / {{result}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "API 当前等待结果的请求",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "exchange_api_requests_pending",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "定序 / 行情完整成功序号",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "exchange_pipeline_completed_sequence",
          "legendFormat": "{{application}} / {{stage}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "本地工作组件状态",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "exchange_component_ready",
          "legendFormat": "{{application}} / {{component}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Kafka 已分配分区客户端 lag",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumer_fetch_manager_records_lag",
          "legendFormat": "{{application}} / {{topic}} / {{partition}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Push WebSocket 连接数（含匿名）",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "exchange_push_connections",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Push Redis 连接与真实订阅",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"exchange_push_redis_(connected|subscribed)\"}",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 15,
      "title": "Push 收通知 / 写入结果速率",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(exchange_push_operations_total[2m])",
          "legendFormat": "{{stage}} / {{result}}"
        }
      ]
    },
    {
      "id": 16,
      "title": "业务处理平均耗时（秒）",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(exchange_pipeline_duration_seconds_sum[2m]) / rate(exchange_pipeline_duration_seconds_count[2m])",
          "legendFormat": "{{application}} / {{stage}}"
        }
      ]
    }
  ]
}
