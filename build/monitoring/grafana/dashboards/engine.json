{
  "description": "交易引擎第一阶段监控：恢复、完整事件进度、快照、输出线程和 JVM。序号差距不是事件条数；线程存活不证明外部投递成功。",
  "uid": "exchange-engine",
  "title": "Stock Exchange - 交易引擎",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "title": "抓取成功（1）/失败（0）", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "up{job=\"trading-engine\"}"}]},
    {"id": 2, "title": "引擎就绪（1）/未就绪（0）", "type": "stat", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "exchange_engine_ready{job=\"trading-engine\"}"}]},
    {"id": 3, "title": "当前状态（值为1的状态生效）", "type": "stat", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 4}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "exchange_engine_state{job=\"trading-engine\"}", "legendFormat": "{{state}}"}]},
    {"id": 4, "title": "已执行 / 启动恢复上界 / 已保存快照序号", "type": "timeseries", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "exchange_engine_applied_sequence", "legendFormat": "已执行"}, {"refId": "B", "expr": "exchange_recovery_target_sequence", "legendFormat": "启动恢复上界"}, {"refId": "C", "expr": "exchange_snapshot_saved_sequence", "legendFormat": "已保存快照"}]},
    {"id": 5, "title": "未保存序号差距（不是事件条数）", "type": "timeseries", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "exchange_snapshot_unsaved_sequence_distance"}]},
    {"id": 6, "title": "事件处理速率（次/秒）", "type": "timeseries", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "rate(exchange_events_total[2m])", "legendFormat": "{{mode}} / {{result}}"}]},
    {"id": 7, "title": "输出队列待处理任务（不含处理中任务）", "type": "timeseries", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "exchange_output_pending", "legendFormat": "{{queue}}"}]},
    {"id": 8, "title": "输出线程存活（1）/退出（0）", "type": "timeseries", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "exchange_output_worker_alive", "legendFormat": "{{worker}}"}]},
    {"id": 9, "title": "最近5分钟快照 / 恢复 / 输出异常次数", "type": "timeseries", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "increase(exchange_snapshot_save_total{result=\"failure\"}[5m])", "legendFormat": "快照失败"}, {"refId": "B", "expr": "increase(exchange_recovery_completed_total{result=\"failure\"}[5m])", "legendFormat": "恢复失败"}, {"refId": "C", "expr": "increase(exchange_output_failures_total[5m])", "legendFormat": "输出 {{worker}}"}]},
    {"id": 10, "title": "平均事件耗时（秒；无事件时无数据）", "type": "timeseries", "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "rate(exchange_event_duration_seconds_sum[2m]) / rate(exchange_event_duration_seconds_count[2m])", "legendFormat": "{{mode}}"}]},
    {"id": 11, "title": "平均快照保存耗时（秒；包括捕获和编码）", "type": "timeseries", "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "rate(exchange_snapshot_save_duration_seconds_sum[5m]) / rate(exchange_snapshot_save_duration_seconds_count[5m])"}]},
    {"id": 12, "title": "JVM 内存使用（字节）", "type": "timeseries", "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "jvm_memory_used_bytes", "legendFormat": "{{area}} / {{id}}"}]},
    {"id": 13, "title": "进程 CPU 使用率（0～1）", "type": "timeseries", "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "exchange-prometheus"}, "targets": [{"refId": "A", "expr": "process_cpu_usage"}]}
  ]
}
