{
  "description": "七个应用的进程、就绪、HTTP 和资源；抓取成功不证明业务链路成功。",
  "uid": "exchange-system",
  "title": "Stock Exchange - 系统总览",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "各应用抓取成功（1）/失败（0）",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "各应用本地就绪（1）/未就绪（0）",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "exchange_component_ready{component=\"application\",application!=\"trading-engine\"} or exchange_engine_ready",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 请求速率（次/秒；不含 Push 的 Vert.x 请求）",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[2m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP 5xx 速率（次/秒）",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[2m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP 平均耗时（秒；无请求时无数据）",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_sum[2m])) / sum by (application) (rate(http_server_requests_seconds_count[2m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "进程 CPU 使用率（0～1）",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "JVM 内存使用（字节）",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, area) (jvm_memory_used_bytes)",
          "legendFormat": "{{application}} / {{area}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "JVM 存活线程数",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_threads_live_threads",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "进程启动时间（Unix 秒）",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_start_time_seconds",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "GC 暂停时间速率（秒/秒）",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "exchange-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(jvm_gc_pause_seconds_sum[2m]))",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ]
}
