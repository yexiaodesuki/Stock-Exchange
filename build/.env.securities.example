# 证券私密配置示例；复制为同目录 .env.securities 并填写随机值，禁止上传实际密码。
SEC_MYSQL_PORT=13306
SEC_REDIS_PORT=16379
SEC_KAFKA_PORT=19092
SEC_MYSQL_ROOT_PASSWORD=replace-with-random-root-password
SEC_MYSQL_PASSWORD=replace-with-random-application-password
SECURITIES_AUTH_KEY=replace-with-at-least-32-random-characters
SEC_GRAFANA_PASSWORD=replace-with-random-grafana-password
# 十个初始用户分别填写不同密码；应用在项目根目录运行时直接读取此文件，无需启动脚本。
SECURITIES_DEMO_ENABLED=true
SECURITIES_DEMO_USER1_PASSWORD=replace-with-random-user1-password
SECURITIES_DEMO_USER2_PASSWORD=replace-with-random-user2-password
SECURITIES_DEMO_USER3_PASSWORD=replace-with-random-user3-password
SECURITIES_DEMO_USER4_PASSWORD=replace-with-random-user4-password
SECURITIES_DEMO_USER5_PASSWORD=replace-with-random-user5-password
SECURITIES_DEMO_USER6_PASSWORD=replace-with-random-user6-password
SECURITIES_DEMO_USER7_PASSWORD=replace-with-random-user7-password
SECURITIES_DEMO_USER8_PASSWORD=replace-with-random-user8-password
SECURITIES_DEMO_USER9_PASSWORD=replace-with-random-user9-password
SECURITIES_DEMO_USER10_PASSWORD=replace-with-random-user10-password
